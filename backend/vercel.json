{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "fluid": true,
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/downloads/tteumsae-latest-debug.apk",
      "destination": "/downloads/tteumsae-v0.4.0-debug.apk"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/tour-sync",
      "schedule": "20 18 * * *"
    },
    {
      "path": "/api/cron/tour-detail-sync",
      "schedule": "40 18 * * *"
    }
  ]
}
